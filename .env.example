# DisasterMesh Node Environment Variables Configuration
# Optional: Set these if you want to override default behavior without CLI arguments

# Network bind settings
HOST=0.0.0.0
PORT=5000

# Node identity
DEVICE_ID=Node-Alpha

# Automatic mDNS local peer discovery (true/false)
ENABLE_MDNS=true

# Manual static peer WebSocket URL to bootstrap into mesh (e.g. ws://192.168.1.50:5000)
PEER_URL=

# Run node with operations rescue dashboard enabled (true/false)
IS_RESCUE_BASE=false

# Visual operations dashboard port (default: PORT + 1000)
DASHBOARD_PORT=6000

# SQLite storage directory (default: ./data)
STORAGE_DIR=./data

# Default search TTL hops for multi-hop route queries
DEFAULT_SEARCH_TTL=15
